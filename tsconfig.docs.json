{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM"],
    "paths": {
      "@groundhogchain/xdr": ["./packages/xdr/src/index.ts"],
      "@groundhogchain/protocol": ["./packages/protocol/src/index.ts"],
      "@groundhogchain/protocol/utils": ["./packages/protocol/src/utils/index.ts"],
      "@groundhogchain/rpc": ["./packages/rpc/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*.ts"],
  "exclude": ["node_modules", "packages/*/dist"]
}
