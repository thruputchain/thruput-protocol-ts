// -*- TypeScript -*-
// Reference codegen output for unions with default arms.
//
// THIS IS THE SPEC — x23c should produce output matching these patterns.
//
// Three patterns:
// 1. No default arm — throw on unknown discriminant (existing, unchanged)
// 2. Default arm with void body — catch-all { disc: number } + field validation
// 3. Default arm with data body — same + default body encoding

import type { XdrCodec } from "@groundhog/xdr";
import * as proto from "../index.js";

// ============================================================================
// Pattern 1: No default arm (UNCHANGED — already correct)
//
// union StorageKey switch (StorageKeyType key_type) {
//   case ContractData: StorageKeyContractData contract_data_key;
//   case FreeNativeTokenBalance: void;
//   ...
// };
// ============================================================================

export type StorageKey =
  | { key_type: proto.StorageKeyType.ContractData; contract_data_key: proto.StorageKeyContractData }
  | { key_type: proto.StorageKeyType.FreeNativeTokenBalance }
  | { key_type: proto.StorageKeyType.AuthData }
  | { key_type: proto.StorageKeyType.Metadata }
  | { key_type: proto.StorageKeyType.ReplayCache }
;

const _StorageKey: XdrCodec<StorageKey> = {
  encode(w, val) {
    w.writeInt32(BigInt(val.key_type));
    switch (val.key_type) {
      case proto.StorageKeyType.ContractData:
        // TypeScript narrows correctly — no cast needed, no validation needed
        proto.codec.StorageKeyContractData.encode(w, val.contract_data_key);
        break;
      case proto.StorageKeyType.FreeNativeTokenBalance:
      case proto.StorageKeyType.AuthData:
      case proto.StorageKeyType.Metadata:
      case proto.StorageKeyType.ReplayCache:
        break;
    }
  },
  decode(r) {
    const key_type = Number(r.readInt32());
    switch (key_type) {
      case proto.StorageKeyType.ContractData:
        return { key_type, contract_data_key: proto.codec.StorageKeyContractData.decode(r) };
      case proto.StorageKeyType.FreeNativeTokenBalance:
      case proto.StorageKeyType.AuthData:
      case proto.StorageKeyType.Metadata:
      case proto.StorageKeyType.ReplayCache:
        return { key_type } as StorageKey;
      default:
        throw new Error(`Unknown StorageKey discriminant: ${key_type}`);
    }
  },
};

// ============================================================================
// Pattern 2: Default arm with void body
//
// union ExpectedStorageCost switch (RPCError error) {
//   case kRPCNone: StorageCost storage_cost;
//   default: void;
// };
//
// KEY DIFFERENCES from pattern 1:
// - Type has | { disc: number } catch-all as the last variant
// - Encode: cast to INLINE VARIANT TYPE (not Extract<>) + validate field exists
// - Decode: default returns { disc } instead of throwing
// ============================================================================

export type ExpectedStorageCost =
  | { error: proto.RPCError.kRPCNone; storage_cost: proto.StorageCost }
  | { error: number }
;

const _ExpectedStorageCost: XdrCodec<ExpectedStorageCost> = {
  encode(w, val) {
    w.writeInt32(BigInt(val.error));
    switch (val.error) {
      case proto.RPCError.kRPCNone: {
        // Cast to the INLINE variant type — NOT Extract<>, which fails
        // because { error: number } overlaps all specific variants.
        const v = val as { error: proto.RPCError.kRPCNone; storage_cost: proto.StorageCost };
        // Validate the field exists — catches discriminant/field mismatches
        if (v.storage_cost === undefined) {
          throw new Error("ExpectedStorageCost encode: discriminant is kRPCNone but storage_cost is undefined");
        }
        proto.codec.StorageCost.encode(w, v.storage_cost);
        break;
      }
      // default: void — nothing to encode, nothing to validate
    }
  },
  decode(r) {
    const error = Number(r.readInt32());
    switch (error) {
      case proto.RPCError.kRPCNone:
        return { error, storage_cost: proto.codec.StorageCost.decode(r) };
      default:
        // Don't throw — return the discriminant for forward compatibility
        return { error };
    }
  },
};

// Another pattern 2 example with multiple known arms:
//
// union WalletTransactionAck switch (WalletTransactionAckType ack_type) {
//   case WalletTransactionNotSubmitted: void;
//   case WalletTransactionSubmitted: WalletSubmittedTransactionID submitted_transaction_id;
//   default: void;
// };

export type WalletTransactionAck =
  | { ack_type: proto.WalletTransactionAckType.WalletTransactionNotSubmitted }
  | { ack_type: proto.WalletTransactionAckType.WalletTransactionSubmitted; submitted_transaction_id: proto.WalletSubmittedTransactionID }
  | { ack_type: number }
;

const _WalletTransactionAck: XdrCodec<WalletTransactionAck> = {
  encode(w, val) {
    w.writeInt32(BigInt(val.ack_type));
    switch (val.ack_type) {
      case proto.WalletTransactionAckType.WalletTransactionNotSubmitted:
        // void arm — nothing to encode
        break;
      case proto.WalletTransactionAckType.WalletTransactionSubmitted: {
        const v = val as { ack_type: proto.WalletTransactionAckType.WalletTransactionSubmitted; submitted_transaction_id: proto.WalletSubmittedTransactionID };
        if (v.submitted_transaction_id === undefined) {
          throw new Error("WalletTransactionAck encode: discriminant is WalletTransactionSubmitted but submitted_transaction_id is undefined");
        }
        proto.codec.WalletSubmittedTransactionID.encode(w, v.submitted_transaction_id);
        break;
      }
      // default: void — nothing to encode
    }
  },
  decode(r) {
    const ack_type = Number(r.readInt32());
    switch (ack_type) {
      case proto.WalletTransactionAckType.WalletTransactionNotSubmitted:
        return { ack_type };
      case proto.WalletTransactionAckType.WalletTransactionSubmitted:
        return { ack_type, submitted_transaction_id: proto.codec.WalletSubmittedTransactionID.decode(r) };
      default:
        return { ack_type };
    }
  },
};

// ============================================================================
// Pattern 3: Default arm with data body
//
// union Foo switch (int tag) {
//   case 0: BarData bar;
//   case 1: void;
//   default: opaque raw_data<>;
// };
// ============================================================================

export type Foo =
  | { tag: 0; bar: proto.BarData }
  | { tag: 1 }
  | { tag: number; raw_data: Uint8Array }
;

const _Foo: XdrCodec<Foo> = {
  encode(w, val) {
    w.writeInt32(BigInt(val.tag));
    switch (val.tag) {
      case 0: {
        const v = val as { tag: 0; bar: proto.BarData };
        if (v.bar === undefined) {
          throw new Error("Foo encode: discriminant is 0 but bar is undefined");
        }
        proto.codec.BarData.encode(w, v.bar);
        break;
      }
      case 1:
        break;
      default: {
        const v = val as { tag: number; raw_data: Uint8Array };
        if (v.raw_data === undefined) {
          throw new Error("Foo encode: default arm but raw_data is undefined");
        }
        w.writeVarOpaque(v.raw_data, Number(0xFFFFFFFF));
        break;
      }
    }
  },
  decode(r) {
    const tag = Number(r.readInt32());
    switch (tag) {
      case 0:
        return { tag, bar: proto.codec.BarData.decode(r) };
      case 1:
        return { tag };
      default:
        return { tag, raw_data: r.readVarOpaque(Number(0xFFFFFFFF)) };
    }
  },
};

// ============================================================================
// CODEGEN RULES SUMMARY
//
// TYPE:
//   No default:     only known variant arms
//   Default void:   known arms + | { disc: number }
//   Default data:   known arms + | { disc: number; field: Type }
//
// ENCODE (for unions WITH a default arm):
//   Each data arm:
//     case VARIANT: {
//       const v = val as { disc: VARIANT; field1: Type1; field2: Type2 };
//       if (v.field1 === undefined) throw new Error("... field1 is undefined");
//       encode(v.field1);
//       break;
//     }
//   Void arm:       case VARIANT: break;
//   Default void:   (no default case needed — falls through)
//   Default data:
//     default: {
//       const v = val as { disc: number; field: Type };
//       if (v.field === undefined) throw new Error("... field is undefined");
//       encode(v.field);
//       break;
//     }
//
// ENCODE (for unions WITHOUT a default arm):
//   No cast needed — TypeScript narrows correctly in switch cases.
//   No validation needed — type system prevents mismatches.
//
// DECODE:
//   No default:     default: throw new Error(`Unknown Foo discriminant: ${disc}`)
//   Default void:   default: return { disc }
//   Default data:   default: return { disc, field: decode() }
// ============================================================================

export const codec = {
  StorageKey: _StorageKey,
  ExpectedStorageCost: _ExpectedStorageCost,
  WalletTransactionAck: _WalletTransactionAck,
  Foo: _Foo,
} as const;
