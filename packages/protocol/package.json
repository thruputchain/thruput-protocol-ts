{
  "name": "@thruputchain/protocol",
  "version": "0.15.0",
  "description": "Thruput blockchain protocol types and XDR serialization",
  "homepage": "https://github.com/thruputchain/thruput-protocol-ts/tree/main/packages/protocol#readme",
  "bugs": {
    "url": "https://github.com/thruputchain/thruput-protocol-ts/issues"
  },
  "keywords": [
    "thruput",
    "blockchain",
    "protocol",
    "xdr"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js",
      "require": "./dist/utils/index.cjs"
    }
  },
  "tsdown": {
    "fixedExtension": false
  },
  "scripts": {
    "build": "tsdown src/index.ts src/utils/index.ts --format esm,cjs --dts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@thruputchain/xdr": "0.15.0",
    "@noble/hashes": "2.2.0"
  },
  "devDependencies": {
    "@types/node": "25.5.0",
    "@vitest/coverage-v8": "4.1.8",
    "tsdown": "0.22.2",
    "typescript": "5.9.3",
    "vitest": "4.1.8"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thruputchain/thruput-protocol-ts.git",
    "directory": "packages/protocol"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}
