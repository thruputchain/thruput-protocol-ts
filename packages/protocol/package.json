{
  "name": "@groundhogchain/protocol",
  "version": "0.5.0",
  "description": "Groundhog blockchain protocol types and XDR serialization",
  "type": "module",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js",
      "require": "./dist/utils/index.cjs"
    }
  },
  "tsdown": {
    "fixedExtension": false
  },
  "scripts": {
    "build": "tsdown src/index.ts src/utils/index.ts --format esm,cjs --dts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@groundhogchain/xdr": "0.5.0",
    "@noble/hashes": "2.2.0"
  },
  "devDependencies": {
    "@types/node": "25.5.0",
    "@vitest/coverage-v8": "4.1.8",
    "tsdown": "0.22.2",
    "typescript": "5.9.3",
    "vitest": "4.1.8"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/groundhogchain/protocol-ts.git",
    "directory": "packages/protocol"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}
